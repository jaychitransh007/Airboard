{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airboard.dev/evals/schema/interaction-eval-case.v1.schema.json",
  "title": "InteractionEvalCase",
  "description": "A versioned, executor-neutral offline interaction evaluation case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "corpusVersion",
    "modality",
    "surface",
    "riskLevel",
    "datasetAssetHash",
    "capabilities",
    "interaction",
    "expected"
  ],
  "properties": {
    "schemaVersion": {
      "const": "interaction-eval-case.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "enum": [
        "typed",
        "voice",
        "gesture",
        "pointer",
        "touchpad",
        "stylus",
        "keyboard",
        "catalog",
        "lifecycle",
        "remote",
        "multimodal"
      ]
    },
    "surface": {
      "enum": [
        "standalone",
        "meet",
        "desktop",
        "browser",
        "replay"
      ]
    },
    "riskLevel": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "destructive"
      ]
    },
    "datasetAssetHash": {
      "type": "string",
      "pattern": "^(?:sha256:[a-f0-9]{64}|none)$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initial": {
      "$ref": "#/$defs/statePair"
    },
    "interaction": {
      "$ref": "#/$defs/interaction"
    },
    "expected": {
      "$ref": "#/$defs/expectation"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "statePair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boardState": {
          "type": "object"
        },
        "nonBoardState": {}
        ,
        "selection": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pointer": {
          "type": [
            "object",
            "null"
          ]
        },
        "viewport": {
          "type": "object"
        },
        "activeTool": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": "boolean"
        },
        "mediaState": {
          "type": "object"
        },
        "pendingInteraction": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "channel",
        "input"
      ],
      "properties": {
        "channel": {
          "enum": [
            "typed",
            "voice",
            "gesture",
            "touchpad",
            "keyboard",
            "pointer",
            "stylus",
            "catalog",
            "lifecycle",
            "remote",
            "multimodal",
            "api",
            "replay"
          ]
        },
        "input": {},
        "commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sequence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputEvent"
          }
        }
      }
    },
    "inputEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "atMs",
        "type"
      ],
      "properties": {
        "atMs": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "enum": [
            "transcript",
            "pcm",
            "audio_asset",
            "transcription_provider",
            "raw_detected_hands",
            "landmark_frame",
            "pointer",
            "keyboard",
            "catalog",
            "lifecycle",
            "provider_failure",
            "remote_board_event"
          ]
        }
      }
    },
    "comparisonMode": {
      "enum": [
        "exact",
        "partial"
      ]
    },
    "geometryTolerance": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "number",
              "minimum": 0
            },
            "position": {
              "type": "number",
              "minimum": 0
            },
            "size": {
              "type": "number",
              "minimum": 0
            },
            "point": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "board": {
          "$ref": "#/$defs/comparisonMode"
        },
        "nonBoard": {
          "$ref": "#/$defs/comparisonMode"
        },
        "delta": {
          "$ref": "#/$defs/comparisonMode"
        },
        "geometryTolerance": {
          "$ref": "#/$defs/geometryTolerance"
        },
        "timestampMode": {
          "enum": [
            "logical",
            "preserve",
            "omit"
          ]
        },
        "includeDeleted": {
          "type": "boolean"
        },
        "ignoreFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbiddenMutation": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "enum": [
                "board",
                "nonBoard",
                "all"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "exactOnce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "minProperties": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "undoRoundTrip": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "board": {
              "type": "boolean"
            },
            "nonBoard": {
              "type": "boolean"
            },
            "requireUndoEvents": {
              "type": "boolean"
            },
            "includeDeleted": {
              "type": "boolean"
            },
            "ignoreFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "actionRule": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "match"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "match": {
              "type": "object",
              "minProperties": 1
            },
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "latencyBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalMs": {
          "type": "number",
          "minimum": 0
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "applied",
            "clarification",
            "no-op",
            "rejected",
            "error"
          ]
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "route": {},
        "processingPath": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "semanticPlan": {
          "type": "object"
        },
        "allowedSemanticAlternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "requiredActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionRule"
          }
        },
        "forbiddenActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionRule"
          }
        },
        "feedbackCategory": {
          "type": "string"
        },
        "stageOutcomes": {
          "type": "object"
        },
        "latencyBudget": {
          "$ref": "#/$defs/latencyBudget"
        },
        "finalBoardState": {
          "type": "object"
        },
        "finalStateConstraints": {
          "type": "object"
        },
        "finalNonBoardState": {},
        "boardDelta": {
          "type": "object"
        },
        "eventDelta": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forbiddenMutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbiddenMutation"
          }
        },
        "exactOnce": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exactOnce"
          }
        },
        "undoRoundTrip": {
          "$ref": "#/$defs/undoRoundTrip"
        }
      }
    }
  }
}
