{
  "name": "airboard",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @airboard/web --filter @airboard/api dev",
    "dev:web": "pnpm --filter @airboard/web dev",
    "dev:api": "pnpm --filter @airboard/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "eval:voice": "node scripts/eval-voice-intent.mjs",
    "eval:false-accepts": "node scripts/eval-false-accepts.mjs",
    "eval:grammar": "node scripts/eval-grammar.mjs",
    "eval:contract": "node scripts/eval-contract-matrix.mjs",
    "eval:provider-events": "node scripts/eval-provider-events.mjs",
    "eval:interactions": "node scripts/eval-interactions.mjs",
    "eval:gesture": "node scripts/eval-gesture-replay.mjs",
    "eval:datasets": "node scripts/validate-eval-datasets.mjs",
    "eval:coverage": "node scripts/eval-capability-coverage.mjs",
    "eval:faults": "node scripts/eval-seeded-faults.mjs",
    "eval:quality": "node scripts/eval-quality-gate.mjs --mode pr",
    "eval:quality-report": "node scripts/eval-quality-report.mjs --mode pr --output artifacts/evals/quality-report-policy.json",
    "eval:semantic": "node scripts/eval-semantic-metamorphic.mjs --validate-only",
    "eval:semantic-negatives": "node scripts/eval-semantic-negatives.mjs --validate-only",
    "eval:audio": "node scripts/eval-audio-stt.mjs",
    "eval:pr": "node scripts/run-eval-suite.mjs --tier pr",
    "docs:build": "node scripts/generate-help-content.mjs",
    "docs:check": "node scripts/generate-help-content.mjs --check",
    "smoke:commercial": "node scripts/smoke-commercial-journey.mjs",
    "smoke:deploy": "node scripts/smoke-deploy-account.mjs",
    "launch:check": "node --env-file-if-exists=.env scripts/launch-ready-check.mjs",
    "launch:check:deployed": "node scripts/launch-ready-check.mjs --deployed --project=project-1217dd57-9cac-491d-b8d",
    "launch:check:paid": "node --env-file-if-exists=.env scripts/launch-ready-check.mjs --scope=paid-ga",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
