{
  "name": "airboard",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @airboard/web dev",
    "dev:api": "pnpm --filter @airboard/api dev",
    "dev:desktop": "pnpm --filter @airboard/desktop dev",
    "build": "pnpm -r build",
    "build:extension": "node scripts/package-chrome-extension.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval:voice": "node scripts/eval-voice-intent.mjs",
    "eval:false-accepts": "node scripts/eval-false-accepts.mjs",
    "eval:grammar": "node scripts/eval-grammar.mjs",
    "smoke:commercial": "node scripts/smoke-commercial-journey.mjs",
    "launch:check": "node --env-file-if-exists=.env scripts/launch-ready-check.mjs",
    "launch:check:paid": "node --env-file-if-exists=.env scripts/launch-ready-check.mjs --scope=paid-ga",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
