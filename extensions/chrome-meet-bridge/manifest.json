{
  "manifest_version": 3,
  "name": "Airboard for Google Meet",
  "short_name": "Airboard",
  "version": "0.8.0",
  "description": "Adds live neon diagrams to your outgoing Meet camera after you connect Airboard and confirm camera and microphone use.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://airboard-pilot-api-634900453473.asia-south1.run.app/*",
    "http://127.0.0.1:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Airboard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["compositor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine.html", "engine-relay.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://airboard-pilot-web-634900453473.asia-south1.run.app https://airboard-pilot-web-efs77okmmq-el.a.run.app http://localhost:3000 http://127.0.0.1:3100"
  },
  "externally_connectable": {
    "matches": [
      "https://airboard-pilot-web-634900453473.asia-south1.run.app/*",
      "https://airboard-pilot-web-efs77okmmq-el.a.run.app/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3100/*"
    ]
  }
}
