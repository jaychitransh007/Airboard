NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from-supabase-status-publishable-key>
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=<from-supabase-status-secret-key>
# Google sign-in OAuth client (Google Cloud console > Google Auth Platform >
# Clients). Used by `supabase config push`; the secret never goes in git.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
AIRBOARD_OWNER_GRACE_SECONDS=180
AIRBOARD_LOCAL_ENTITLEMENTS=true
AIRBOARD_ALLOWED_ORIGINS=http://localhost:3000
AIRBOARD_APP_URL=http://localhost:3000
# Web runtime only: requests for these comma-separated alias hosts get a 307 to
# the canonical origin, because Supabase redirects sign-in links only there.
# Leave unset locally. On Cloud Run, list the service's second run.app hostname.
# AIRBOARD_CANONICAL_WEB_ORIGIN=https://airboard-pilot-web-634900453473.asia-south1.run.app
# AIRBOARD_WEB_ALIAS_HOSTS=airboard-pilot-web-efs77okmmq-el.a.run.app
AIRBOARD_SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Protects operational metrics and optional provider-spending endpoints.
AIRBOARD_API_TOKEN=replace-with-a-separate-random-operational-token
# Proxies whose X-Forwarded-For entries are trusted when deriving client IPs
# for anonymous rate limits. Defaults to 1 on Cloud Run (K_SERVICE set) and 0
# elsewhere; use 2 with an external load balancer in front of Cloud Run.
# AIRBOARD_TRUSTED_PROXY_HOPS=1
# Live-board edits reach sockets held by other API instances over private
# Supabase Realtime channels. "off" keeps them on one instance.
# AIRBOARD_REALTIME_FANOUT=off
# Maintenance switch: "true" refuses every change with 503 MAINTENANCE and
# pauses live boards, e.g. while the database moves.
# AIRBOARD_READ_ONLY=false
NEXT_PUBLIC_AIRBOARD_API_URL=http://127.0.0.1:4000
# Read only by the launch check (pnpm launch:check). The board socket URL
# follows NEXT_PUBLIC_AIRBOARD_API_URL; set this only to override it.
# AIRBOARD_WS_URL=wss://api.example.com/ws

# Realtime speech recognition. Keys stay on the API server and are never sent
# to the browser. Change the default/allowed model list without changing code.
AIRBOARD_TRANSCRIPTION_PROVIDER=deepgram
AIRBOARD_TRANSCRIPTION_MODEL=flux-general-en
AIRBOARD_TRANSCRIPTION_ALLOWED_MODELS=flux-general-en,flux-general-multi
AIRBOARD_TRANSCRIPTION_KEYTERMS=Airo,Airboard,Hey Airo,Airo add a circle here,Airo add a user here,Airo connect User to API,Airo confirm,Airo cancel,add a circle here,add a user here,add an API here,add a database here,add a service here,add a queue here,connect User to API,API,database,queue,connector,service,circle,user,payment
AIRBOARD_TRANSCRIPTION_EOT_THRESHOLD=0.7
AIRBOARD_TRANSCRIPTION_EAGER_EOT_THRESHOLD=0.4
AIRBOARD_TRANSCRIPTION_EOT_TIMEOUT_MS=1200
# Live voice streams per API instance. Deepgram allows 150 per project and
# production runs at most 3 instances.
AIRBOARD_TRANSCRIPTION_MAX_CONCURRENT_STREAMS=50
# Per-account cap so one account cannot hold every stream slot. Two allows a
# live Airo stream plus one reconnect overlap.
AIRBOARD_TRANSCRIPTION_MAX_STREAMS_PER_PROFILE=2
AIRBOARD_TRANSCRIPTION_MAX_SESSION_MS=1800000
AIRBOARD_TRANSCRIPTION_MAX_AUDIO_BYTES_PER_SECOND=131072
# How long the API waits for Deepgram to accept a new stream.
# AIRBOARD_TRANSCRIPTION_CONNECT_TIMEOUT_MS=10000
DEEPGRAM_WEBSOCKET_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_API_KEY=

# Daily limits on the paid providers, counted in the database across API
# instances: each person's own allowance, then one ceiling for everyone
# together however many accounts sign up. All reset at midnight UTC.
AIRBOARD_DAILY_AIRO_COMMANDS=500
AIRBOARD_DAILY_VOICE_MINUTES=240
AIRBOARD_SERVICE_DAILY_AIRO_COMMANDS=5000
AIRBOARD_SERVICE_DAILY_VOICE_MINUTES=3000

# Abuse limits. Defaults shown; raise them only for a load test or an isolated
# test process. Board events are counted per socket every 10 seconds; the rest
# are per minute.
# AIRBOARD_RATE_LIMIT_INTENT_PER_MINUTE=30
# AIRBOARD_RATE_LIMIT_SESSION_START_PER_MINUTE=10
# AIRBOARD_RATE_LIMIT_VOICE_TRACE_PER_MINUTE=240
# AIRBOARD_RATE_LIMIT_BOARD_CONNECTIONS_PER_MINUTE=120
# AIRBOARD_RATE_LIMIT_BOARD_READS_PER_MINUTE=300
# AIRBOARD_RATE_LIMIT_TRANSCRIPTION_CONNECTIONS_PER_MINUTE=60
# AIRBOARD_RATE_LIMIT_BOARD_EVENTS_PER_10_SECONDS=5000
# Board sockets each API instance holds: per person on one board (tabs plus a
# reconnect overlap), per caller address, and per live session.
# AIRBOARD_BOARD_SOCKETS_PER_PARTICIPANT=3
# AIRBOARD_BOARD_SOCKETS_PER_CALLER=30
# AIRBOARD_BOARD_SOCKETS_PER_SESSION=50

# Semantic command interpretation. The deterministic command parser remains the
# zero-network fast path; this provider is called only for an explicitly
# activated, non-empty command the parser cannot finish safely. Credentials
# stay on the API server and are never exposed as
# NEXT_PUBLIC variables.
AIRBOARD_INTENT_PROVIDER=openai
AIRBOARD_INTENT_MODEL=gpt-5.6-luna
AIRBOARD_INTENT_ALLOWED_MODELS=gpt-5.6-luna
AIRBOARD_INTENT_REASONING_EFFORT=none
# priority answers voice commands faster at a higher OpenAI token price;
# auto or default uses the standard tier.
AIRBOARD_INTENT_SERVICE_TIER=priority
AIRBOARD_INTENT_TIMEOUT_MS=5000
AIRBOARD_INTENT_MAX_CONCURRENT_REQUESTS=8
AIRBOARD_INTENT_MAX_TRANSCRIPT_CHARACTERS=2000
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Set exactly one server-side key. AIRBOARD_INTENT_API_KEY takes precedence;
# OPENAI_API_KEY is the supported fallback. Leave both unset to disable only
# semantic interpretation while keeping deterministic commands available.
# AIRBOARD_INTENT_API_KEY=
# OPENAI_API_KEY=

# Commercial lifecycle. Credentials alone do not enable checkout: keep this
# explicit release switch false until the paid-GA launch gate passes.
AIRBOARD_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
AIRBOARD_CRON_SECRET=

# Provider-neutral lifecycle email outbox delivery (Resend adapter).
RESEND_API_KEY=
# Offer email sign-in links. Off in production unless "true"; on locally.
# AIRBOARD_EMAIL_SIGN_IN_ENABLED=false
AIRBOARD_EMAIL_FROM=Airboard <hello@airboard.app>
