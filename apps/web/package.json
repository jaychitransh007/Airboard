{
  "name": "@airboard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/generate-help-content.mjs && next dev --port 3000",
    "build": "node ../../scripts/generate-help-content.mjs && node ../../scripts/verify-camera-layer-contract.mjs && node ../../scripts/verify-automated-command-contract.mjs && next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@airboard/core": "workspace:*",
    "@airboard/drawing-engine": "workspace:*",
    "@airboard/gesture-engine": "workspace:*",
    "@airboard/integrations": "workspace:*",
    "@airboard/realtime-client": "workspace:*",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
