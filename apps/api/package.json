{
  "name": "@airboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=../../.env --watch dist/index.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:fastify --external:@fastify/cors --external:@fastify/websocket --external:heic-convert --external:sharp --external:ws",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@airboard/core": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@fastify/websocket": "^11.3.6",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.8",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2"
  }
}
