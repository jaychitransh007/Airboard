{
  "name": "@airboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=../../.env --watch dist/index.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:fastify --external:@fastify/cors --external:@fastify/websocket --external:ws",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@airboard/core": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.50.0",
    "esbuild": "^0.28.1",
    "fastify": "^5.4.0",
    "tsx": "^4.19.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1"
  }
}
